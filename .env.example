# Copy to .env (git-ignored). Never commit real values.

# Cashfree PG sandbox (Merchant Dashboard > Developers > API keys, TEST environment)
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2026-01-01
# Tenant that uses the live sandbox; other tenants stay on labeled fixtures
CASHFREE_LIVE_MERCHANT=lender_demo

# Public HTTPS URL that reaches this server (e.g. a tunnel) so Cashfree can deliver webhooks.
# Without it, the reconciler polls open links every RECONCILE_INTERVAL_SECONDS instead.
PUBLIC_BASE_URL=http://localhost:8000

# Sarvam (dashboard.sarvam.ai > API keys)
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
SARVAM_REASONING_EFFORT=low

# Cashfree Relay: Inbound Webhook trigger URL copied from Relay > agent > trigger.
# Leave empty to use the explicit manual hand-off (packet shown to the operator).
RELAY_WEBHOOK_URL=
RELAY_WEBHOOK_SECRET=

# Controlled test recipients (comma separated). Links/outreach to anything else are refused.
TEST_RECIPIENTS=9999999999,9999999998,9999999997,9999999990

# Local demo operators' password (synthetic tenants only)
DEMO_OPERATOR_PASSWORD=demo-pass-123
RECONCILE_INTERVAL_SECONDS=10

# 1 = open the dashboard signed in with a scenario switch. Only honoured for requests from this machine (localhost).
DEMO_MODE=0
